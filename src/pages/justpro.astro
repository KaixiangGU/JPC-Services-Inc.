---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import benny from '../assets/images/benny.png';

const steps = [
  { icon: 'search', title: 'Source detection & repair', text: 'We identify the exact origin of the leak with thermal imaging, moisture meters and acoustic detection — fixing the root cause instead of guessing.' },
  { icon: 'shield', title: 'Mold & contamination treatment', text: 'After removing damaged materials, we isolate the space, apply antimicrobial treatments and use air scrubbers or HEPA filtration to stop spores spreading.' },
  { icon: 'home', title: 'Dry-out & restoration', text: 'Once the area is fully dry and safe, we rebuild — drywall, insulation, flooring and finishes — back to the condition before the damage.' },
] as const;
const stats = [
  { value: '300+', label: 'Clients helped' },
  { value: 'A+', label: 'BBB rating' },
  { value: '3-step', label: 'Detect · Treat · Restore' },
];
---
<Base title="JustPro Restoration — Water Damage Emergency Response" description="JustPro by JPC Services: emergency response for leaks, floods and water damage in Greater Vancouver. Source detection, mold treatment and full restoration.">
  <section class="relative overflow-hidden bg-gradient-to-br from-alert to-[#9e1a21] text-white">
    <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-2">
      <div>
        <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/70"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span>JustPro</span></nav>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-white/80">Emergency response</p>
        <h1 class="mt-2 text-4xl font-extrabold !text-white sm:text-5xl">JustPro Restoration</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">Your trusted emergency team for water damage. Sudden leak, flooding or structural damage — we find it, stop it and restore your property.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={site.phoneHref} class="btn bg-white px-8 py-4 text-base text-alert hover:bg-white/90"><Icon name="phone" class="h-5 w-5" /> Call {site.phone}</a>
          <a href="/contact-us/" class="btn-outline px-8 py-4 text-base">Request service</a>
        </div>
      </div>
      <div class="rounded-3xl bg-white p-6 shadow-2xl">
        <Image src={benny} alt="JustPro logo with Benny the Beaver" width={700} class="h-auto w-full" loading="eager" />
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <dl class="container-x grid grid-cols-3 divide-x divide-slate-200 py-8 text-center">
      {stats.map((s) => (<div class="px-2"><dd class="font-display text-2xl font-extrabold text-navy-900 sm:text-4xl">{s.value}</dd><dt class="mt-1 text-xs text-muted sm:text-sm">{s.label}</dt></div>))}
    </dl>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow !text-alert">Why JustPro?</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">More than a quick fix — we restore your peace of mind</h2>
        <p class="mt-4 text-muted">Many companies make temporary surface repairs. We use diagnostic technology to find the real cause, treat it properly and rebuild to last.</p>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {steps.map((s, i) => (
          <div class="relative rounded-2xl border border-slate-200 p-8">
            <span class="absolute right-6 top-6 font-display text-5xl font-extrabold text-slate-100">0{i + 1}</span>
            <span class="relative grid h-12 w-12 place-items-center rounded-xl bg-red-50 text-alert"><Icon name={s.icon} class="h-6 w-6" /></span>
            <h3 class="relative mt-4 text-xl font-bold">{s.title}</h3>
            <p class="relative mt-2 leading-relaxed text-muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-sand">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-alert">Our mascot</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Meet Benny the Beaver</h2>
        <div class="prose-jpc mt-4">
          <p>Born on the banks of the Fraser River, Benny grew up mastering the art of water control — building dams, sealing leaks and restoring nature after every flood.</p>
          <p>From hidden leaks behind drywall to major basement floods, Benny doesn’t just patch things up — he fixes them for good. Follow along for emergency tips, water damage prevention hacks and behind-the-scenes looks at JustPro in action.</p>
        </div>
      </div>
      <blockquote class="rounded-3xl bg-navy-900 p-10 text-center">
        <p class="font-display text-3xl font-extrabold text-white sm:text-4xl">“Stop it.<br /><span class="text-brand-500">Seal it.</span><br />Save it.”</p>
        <footer class="mt-4 text-sm text-white/70">— Benny the Beaver</footer>
      </blockquote>
    </div>
  </section>

  <Reviews limit={3} />
  <CtaBand title="Dealing with water damage right now?" text="Call us and describe what’s happening — the sooner water is stopped, the less damage it does." />
</Base>
