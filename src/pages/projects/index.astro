---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
---
<Base title="Projects" description="Recent renovation, restoration and construction projects by JPC Services Inc. across Greater Vancouver.">
  <PageHero eyebrow="Our work" title="Projects" subtitle={`${site.stats.projects} projects completed across Greater Vancouver — homes, strata buildings, restaurants and retail.`} crumbs={[{ label: 'Projects' }]} />
  <section class="section">
    <div class="container-x grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}/`} class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:shadow-xl hover:shadow-navy-900/5">
          <div class="aspect-[16/10] overflow-hidden">
            <Image src={p.cover} alt={p.title} widths={[400, 700]} sizes="(min-width: 1024px) 400px, 100vw" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          </div>
          <div class="p-6">
            <p class="text-xs font-bold uppercase tracking-wider text-brand-600">{p.category}</p>
            <h2 class="mt-1 text-xl font-bold">{p.title}</h2>
            <p class="mt-1 text-sm text-muted">{p.location}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{p.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  <Reviews limit={3} />
  <CtaBand />
</Base>
