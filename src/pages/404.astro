---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import heroImg from '../assets/images/services/water-leak-detection.jpg';
---
<Base title="Page Not Found" noindex>
  <PageHero eyebrow="404" title="We couldn’t find that page" subtitle="It may have moved when we updated our website." image={heroImg}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary py-4 text-base">Go to home page</a>
      <a href="/services/" class="btn-outline py-4 text-base">Browse services</a>
    </div>
  </PageHero>
</Base>
