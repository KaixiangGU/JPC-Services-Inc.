---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" noindex>
  <section class="section pt-40 lg:pt-48">
    <div class="container-x max-w-2xl text-center">
      <p class="font-display text-8xl font-bold text-accent-500">404</p>
      <h1 class="mt-4 text-5xl">We couldn’t find that page</h1>
      <p class="mt-4 text-muted">It may have moved when we updated our website.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Go to home page</a>
        <a href="/services/" class="btn-navy">Browse services</a>
      </div>
    </div>
  </section>
</Base>
