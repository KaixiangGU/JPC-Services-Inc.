---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" noindex>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <p class="font-display text-7xl font-extrabold text-brand-500">404</p>
      <h1 class="mt-4 text-3xl font-extrabold">We couldn’t find that page</h1>
      <p class="mt-4 text-muted">It may have moved when we updated our website.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Go to home page</a>
        <a href="/services/" class="btn-navy">Browse services</a>
      </div>
    </div>
  </section>
</Base>
