---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Thank You" noindex>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand-100 text-brand-600"><Icon name="check" class="h-8 w-8" /></span>
      <h1 class="mt-6 text-4xl font-extrabold">Thank you — we’ve got your request</h1>
      <p class="mt-4 text-lg text-muted">Our team will review the details and contact you soon. If it’s urgent, please call us directly.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={site.phoneHref} class="btn-primary px-8 py-4"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
        <a href="/" class="btn-navy px-8 py-4">Back to home</a>
      </div>
    </div>
  </section>
</Base>
