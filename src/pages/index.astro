---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GoogleBadge from '../components/GoogleBadge.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, yearsInBusiness } from '../data/site';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { getGoogleStats } from '../lib/google';
const g = await getGoogleStats();
// Hero photo: the JPC team (temporary — replace with a professional team photo when available)
import heroImg from '../assets/images/hero-team.jpg';
import teamOnsite from '../assets/images/team-onsite.jpg';

const featured = services.filter((s) => s.featured).slice(0, 6);
const stats = [
  { value: `${yearsInBusiness}+`, label: 'Years of experience' },
  { value: site.stats.bbb, label: 'BBB rating' },
  { value: '5', label: 'Star Google reviews', star: true },
];
const reasons = [
  { icon: 'search', title: 'We find the real source', text: 'Thermal imaging, moisture meters and acoustic tools — we fix the cause, not just the symptom.' },
  { icon: 'shield', title: 'Honest recommendations', text: 'We repair what needs repairing. No inflated scopes, no unnecessary replacements.' },
  { icon: 'wrench', title: 'Quality materials', text: 'We choose materials for long-term performance, even when a cheaper option would pass.' },
  { icon: 'users', title: 'One accountable team', text: 'Clear communication from first call to final clean-up, with regular updates on your project.' },
] as const;
---
<Base>
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden bg-navy-900">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;" aria-hidden="true"></div>
    <div class="absolute -right-40 top-10 h-[34rem] w-[34rem] rounded-full bg-accent-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-brand-500/25 blur-3xl" aria-hidden="true"></div>

    <div class="container-x relative grid items-center gap-12 pb-20 pt-32 sm:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-40">
      <div class="lg:col-span-6">
        <p class="eyebrow-light">Leaks · Water damage · Renovations</p>
        <h1 class="mt-5 text-[3.4rem] !text-white sm:text-7xl lg:text-[4.4rem] xl:text-[5rem]">
          Vancouver’s <span class="text-accent-500">water damage</span> &amp; renovation experts
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/85">
          Leak detection, flood restoration, renovations and strata maintenance — done right the first time by a team Greater Vancouver has trusted since {site.foundedYear}.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact-us/" class="btn-primary py-4 text-base"><span class="btn-icon"><Icon name="arrowUp" class="h-4 w-4" /></span>Get a Free Quote</a>
          <a href={site.phoneHref} class="btn-outline py-4 text-base"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
        </div>
        <p class="mt-4 text-sm text-white/80">Or call <a href={site.phone2Href} class="font-bold text-white underline-offset-4 hover:underline">{site.phone2}</a></p>
      </div>

      <!-- Team photo card with Google rating -->
      <div class="relative pb-10 lg:col-span-6 lg:pb-12">
        <div class="overflow-hidden rounded-2xl shadow-2xl shadow-navy-950/50 ring-4 ring-white/10">
          <Image src={heroImg} alt="The JPC Services team" widths={[700, 1000, 1440]} sizes="(min-width: 1024px) 600px, 100vw" class="aspect-[4/3] w-full object-cover" loading="eager" fetchpriority="high" />
        </div>
        <GoogleBadge class="absolute -bottom-2 left-4 sm:left-6 lg:-left-8" />
      </div>
    </div>
  </section>

  <!-- ===== About ===== -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">About us</p>
      <h2 class="mt-5 max-w-5xl text-4xl sm:text-5xl lg:text-[3.4rem]">
        We’re more than contractors — we’re your neighbours. We know how stressful a leak or a renovation can be, so we fix problems at the source and do it right.
      </h2>
      <div class="mt-12 grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <Image src={teamOnsite} alt="JPC team reviewing plans on a job site" widths={[600, 1000]} sizes="(min-width: 1024px) 600px, 100vw" class="aspect-[4/3] w-full rounded-xl object-cover" />
        <div>
          <p class="text-lg leading-relaxed text-muted">For {yearsInBusiness}+ years, JPC Services has combined skilled craftsmanship with advanced diagnostic tools. From hidden leaks to full renovations, we bring the same honesty, care and attention to detail to every job — on time and on budget.</p>
          <dl class="mt-8 grid grid-cols-3 gap-x-6 gap-y-8 border-t border-slate-200 pt-8">
            {stats.map((s) => (
              <div>
                <dd class="flex items-center gap-1.5 font-display text-5xl font-bold text-navy-900">{s.value}{s.star && <Icon name="star" class="h-9 w-9 text-star" />}</dd>
                <dt class="mt-1 text-sm text-muted">{s.label}</dt>
              </div>
            ))}
          </dl>
          <a href="/about/" class="btn-primary mt-10"><span class="btn-icon"><Icon name="arrowUp" class="h-4 w-4" /></span>More about JPC</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section class="section bg-sand">
    <div class="container-x">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">Our services</p>
          <h2 class="mt-5 text-5xl sm:text-6xl">From a hidden leak to a full renovation</h2>
        </div>
        <a href="/services/" class="btn-primary"><span class="btn-icon"><Icon name="arrowUp" class="h-4 w-4" /></span>View all {services.length} services</a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <!-- ===== Why choose ===== -->
  <section class="section bg-navy-900 text-white">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow-light">Why choose JPC</p>
        <h2 class="mt-5 text-5xl !text-white sm:text-6xl">Trusted. Technology-driven. Above and beyond.</h2>
        <p class="mt-5 text-white/75">We solve problems at their source using advanced tools and proven techniques — delivering long-term protection and service that goes beyond expectations.</p>
        <a href="/contact-us/" class="btn-primary mt-8"><span class="btn-icon"><Icon name="arrowUp" class="h-4 w-4" /></span>Get a Free Quote</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-7">
        {reasons.map((r) => (
          <div class="rounded-xl bg-white/[0.06] p-7 ring-1 ring-white/10">
            <span class="grid h-12 w-12 place-items-center rounded-lg bg-accent-500 text-white"><Icon name={r.icon} class="h-6 w-6" /></span>
            <h3 class="mt-5 text-2xl !text-white">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{r.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ===== Projects ===== -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="eyebrow">Recent work</p>
          <h2 class="mt-5 text-5xl sm:text-6xl">Featured projects</h2>
        </div>
        <a href="/projects/" class="inline-flex items-center gap-2 font-bold text-navy-900 hover:text-brand-600">View all projects <Icon name="arrowUp" class="h-4 w-4" /></a>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {projects.slice(0, 2).map((p) => (
          <a href={`/projects/${p.slug}/`} class="group relative block overflow-hidden rounded-xl">
            <Image src={p.cover} alt={p.title} widths={[600, 900]} sizes="(min-width: 1024px) 600px, 100vw" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-7 text-white">
              <p class="eyebrow-light !border-accent-500 !text-accent-500">{p.category}</p>
              <h3 class="mt-3 text-3xl !text-white">{p.title}</h3>
              <p class="mt-1 text-sm text-white/80">{p.location}</p>
            </div>
          </a>
        ))}
        <div class="flex flex-col justify-center rounded-xl bg-sand p-10 text-center">
          <p class="font-display text-6xl font-bold text-navy-900">{site.stats.projects}</p>
          <p class="mt-1 font-display text-2xl font-bold uppercase text-navy-900">projects and counting</p>
          <p class="mt-3 text-muted">From townhouse leak repairs to supermarket build-outs across Greater Vancouver.</p>
          <a href="/contact-us/" class="btn-navy mx-auto mt-6">Start your project</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
