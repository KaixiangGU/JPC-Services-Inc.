---
import { Image } from 'astro:assets';
import type { Service } from '../data/services';
import Icon from './Icon.astro';
interface Props { service: Service }
const { service } = Astro.props;
---
<a href={`/services/${service.slug}/`} class="group flex flex-col rounded-xl border border-slate-200 bg-white p-3 transition hover:-translate-y-1 hover:border-transparent hover:shadow-2xl hover:shadow-navy-900/10">
  <div class="aspect-[16/11] overflow-hidden rounded-lg bg-slate-100">
    <Image src={service.image} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
  </div>
  <div class="flex flex-1 flex-col px-3 pb-3 pt-5">
    <h3 class="text-2xl">{service.title}</h3>
    <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{service.summary}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-navy-900 group-hover:text-brand-600">Learn more <Icon name="arrowUp" class="h-4 w-4" /></span>
  </div>
</a>
