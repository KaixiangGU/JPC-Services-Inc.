---
import Icon from './Icon.astro';
import GoogleLogo from './GoogleLogo.astro';
import GoogleBadge from './GoogleBadge.astro';
import { reviews } from '../data/reviews';
import { site } from '../data/site';
interface Props { limit?: number }
const { limit = 6 } = Astro.props;
const list = reviews.slice(0, limit);
---
<section class="section bg-sand">
  <div class="container-x">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Testimonials</p>
        <h2 class="mt-4 text-5xl sm:text-6xl">What our clients say</h2>
      </div>
      <GoogleBadge />
    </div>
    <div class="mt-12 columns-1 gap-6 md:columns-2 lg:columns-3">
      {list.map((r) => (
        <figure class="mb-6 break-inside-avoid rounded-xl bg-white p-7 shadow-sm ring-1 ring-slate-900/5">
          <div class="flex items-center justify-between">
            <div class="flex text-accent-500">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-5 w-5" />)}</div>
            <GoogleLogo class="h-5 w-5" />
          </div>
          <blockquote class="mt-4 text-[15px] leading-relaxed text-ink" lang={r.lang === 'zh' ? 'zh' : undefined}>“{r.text}”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-slate-100 pt-5">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-navy-900 font-display text-lg font-bold text-white">{r.name.charAt(0)}</span>
            <span class="text-sm"><span class="block font-bold text-navy-900">{r.name}</span><span class="text-muted">Google review</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-4 text-center">
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn-navy">Read all {site.stats.googleReviews}+ reviews on Google <Icon name="arrowUp" class="h-4 w-4" /></a>
    </div>
  </div>
</section>
