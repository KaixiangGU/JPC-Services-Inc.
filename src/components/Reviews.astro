---
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import { site } from '../data/site';
interface Props { limit?: number }
const { limit = 6 } = Astro.props;
const list = reviews.slice(0, limit);
---
<section class="section bg-sand">
  <div class="container-x">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Testimonials</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">What our clients say</h2>
      </div>
      <div class="flex items-center gap-4 rounded-2xl bg-white px-5 py-4 shadow-sm">
        <div>
          <div class="flex text-amber-400">{[1,2,3,4,5].map(() => <Icon name="star" class="h-5 w-5" />)}</div>
          <p class="mt-1 text-sm text-muted"><strong class="text-navy-900">Excellent</strong> · {site.stats.googleReviews}+ Google reviews</p>
        </div>
      </div>
    </div>
    <div class="mt-10 columns-1 gap-6 md:columns-2 lg:columns-3">
      {list.map((r) => (
        <figure class="mb-6 break-inside-avoid rounded-2xl bg-white p-6 shadow-sm">
          <div class="flex text-amber-400">{[1,2,3,4,5].map(() => <Icon name="star" class="h-4 w-4" />)}</div>
          <blockquote class="mt-3 text-[15px] leading-relaxed text-ink" lang={r.lang === 'zh' ? 'zh' : undefined}>“{r.text}”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-navy-900 text-sm font-bold text-white">{r.name.charAt(0)}</span>
            <span class="text-sm"><span class="block font-semibold text-navy-900">{r.name}</span><span class="text-muted">Google review</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-4 text-center">
      <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn-navy">Read all reviews on Google <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </div>
</section>
