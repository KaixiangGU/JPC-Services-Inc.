---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 border-t border-slate-200 bg-white shadow-[0_-4px_16px_rgba(0,0,0,0.06)] lg:hidden">
  <a href={site.phoneHref} class="flex h-16 items-center justify-center gap-2 font-semibold text-navy-900">
    <Icon name="phone" class="h-5 w-5 text-brand-600" /> Call Now
  </a>
  <a href="/contact-us/" class="flex h-16 items-center justify-center gap-2 bg-brand-500 font-semibold text-white">
    Free Quote
  </a>
</div>
