---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 lg:hidden">
  <a href={site.phoneHref} class="flex h-16 items-center justify-center gap-2 bg-navy-900 font-bold text-white">
    <Icon name="phone" class="h-5 w-5 text-accent-500" /> Call Now
  </a>
  <a href="/contact-us/" class="flex h-16 items-center justify-center gap-2 bg-accent-500 font-bold text-navy-950">
    Free Quote <Icon name="arrowUp" class="h-4 w-4" />
  </a>
</div>
