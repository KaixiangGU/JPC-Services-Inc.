---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Have a leak, a repair or a renovation in mind?', text = 'Tell us about your project and we’ll get back to you with a free quote.' } = Astro.props;
---
<section class="bg-white py-16 sm:py-20">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-900 to-navy-800 px-6 py-12 sm:px-12 sm:py-14">
      <div class="absolute -bottom-20 -right-16 h-64 w-64 rounded-full bg-brand-500/25 blur-3xl" aria-hidden="true"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-extrabold !text-white sm:text-4xl">{title}</h2>
          <p class="mt-3 text-white/75">{text}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/contact-us/" class="btn-primary px-8 py-4 text-base">Get a Free Quote</a>
          <a href={site.phoneHref} class="btn-outline px-8 py-4 text-base"><Icon name="phone" class="h-5 w-5" /> {site.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>
