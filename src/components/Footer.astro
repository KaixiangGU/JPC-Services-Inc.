---
import { Image } from 'astro:assets';
import badges from '../assets/images/badges.png';
import Icon from './Icon.astro';
import { site, nav, phones } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 text-white/70">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="font-display text-3xl font-bold uppercase text-white">JPC Services Inc.</p>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">Water damage restoration, leak detection, renovations and strata maintenance across Greater Vancouver since {site.foundedYear}.</p>
      <div class="mt-6 inline-block rounded-lg bg-white p-3">
        <Image src={badges} alt="Founding member of CCRAC and BBB Accredited Business" width={170} class="h-auto w-[170px]" />
      </div>
    </div>
    <div class="lg:col-span-3">
      <p class="font-display text-lg font-bold uppercase tracking-wide text-white">Services</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {services.slice(0, 6).map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-accent-500">{s.title}</a></li>)}
        <li><a href="/services/" class="font-semibold text-accent-500 hover:text-white">All services →</a></li>
      </ul>
    </div>
    <div class="lg:col-span-2">
      <p class="font-display text-lg font-bold uppercase tracking-wide text-white">Quick links</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {nav.map((n) => <li><a href={n.href} class="hover:text-accent-500">{n.label}</a></li>)}
      </ul>
    </div>
    <div class="lg:col-span-3">
      <p class="font-display text-lg font-bold uppercase tracking-wide text-white">Contact</p>
      <ul class="mt-4 space-y-3 text-sm">
        {phones.map((p) => <li><a href={p.href} class="flex gap-3 font-semibold text-white hover:text-accent-500"><Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" />{p.number}</a></li>)}
        <li><a href={`mailto:${site.email}`} class="flex gap-3 break-all hover:text-accent-500"><Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" />{site.email}</a></li>
        <li><a href={site.mapsUrl} target="_blank" rel="noopener" class="flex gap-3 hover:text-accent-500"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" /><span>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</span></a></li>
        <li class="flex gap-3"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" /><span>{site.hours.map((h) => <span class="block">{h.days}: {h.time}</span>)}</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} All rights reserved.</p>
      <p class="flex gap-4"><a href="/privacy/" class="hover:text-white">Privacy Policy</a><a href="/terms/" class="hover:text-white">Terms</a></p>
    </div>
  </div>
</footer>
