---
import { Image } from 'astro:assets';
import badges from '../assets/images/badges.png';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="bg-navy-950 text-white/75">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-bold text-white">JPC Services Inc.</p>
      <p class="mt-1 text-sm font-semibold text-brand-500">Yes We Do.</p>
      <p class="mt-4 text-sm leading-relaxed">Water damage restoration, leak detection, renovations and strata maintenance across Greater Vancouver.</p>
      <div class="mt-6 inline-block rounded-xl bg-white p-3">
        <Image src={badges} alt="Founding member of CCRAC and BBB Accredited Business" width={180} class="h-auto w-[180px]" />
      </div>
    </div>
    <div>
      <p class="font-semibold text-white">Services</p>
      <ul class="mt-4 space-y-2 text-sm">
        {services.slice(0, 7).map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-white">{s.title}</a></li>)}
        <li><a href="/services/" class="font-medium text-brand-500 hover:text-white">All services →</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white">Company</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about/" class="hover:text-white">About Us</a></li>
        <li><a href="/projects/" class="hover:text-white">Projects</a></li>
        <li><a href="/justpro/" class="hover:text-white">JustPro Restoration</a></li>
        <li><a href="/careers/" class="hover:text-white">Careers</a></li>
        <li><a href="/contact-us/" class="hover:text-white">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white">Contact</p>
      <ul class="mt-4 space-y-3 text-sm">
        <li><a href={site.phoneHref} class="flex gap-3 hover:text-white"><Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" />{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="flex gap-3 break-all hover:text-white"><Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" />{site.email}</a></li>
        <li><a href={site.mapsUrl} target="_blank" rel="noopener" class="flex gap-3 hover:text-white"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" /><span>{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</span></a></li>
        <li class="flex gap-3"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" /><span>{site.hours.map((h) => <span class="block">{h.days}: {h.time}</span>)}</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} All rights reserved.</p>
      <p class="flex gap-4"><a href="/privacy/" class="hover:text-white">Privacy Policy</a><a href="/terms/" class="hover:text-white">Terms</a></p>
    </div>
  </div>
</footer>
