---
// Prominent Google reviews badge. Numbers come from Google (build time + live refresh in the browser).
import Icon from './Icon.astro';
import GoogleLogo from './GoogleLogo.astro';
import { getGoogleStats } from '../lib/google';
interface Props { variant?: 'card' | 'dark'; class?: string }
const { variant = 'card', class: cls = '' } = Astro.props;
const dark = variant === 'dark';
const g = await getGoogleStats();
---
<a href={g.url} data-g-url target="_blank" rel="noopener"
   class:list={['group inline-flex items-center gap-4 rounded-xl', dark ? 'text-white' : 'bg-white p-4 pr-6 text-navy-900 shadow-xl shadow-navy-950/20', cls]}
   aria-label="Google rating and reviews">
  <span class:list={['grid h-14 w-14 shrink-0 place-items-center rounded-full', dark ? 'bg-white' : 'bg-sand']}><GoogleLogo class="h-8 w-8" /></span>
  <span>
    <span class="flex items-center gap-2">
      <span class="font-display text-4xl font-bold leading-none" data-g-rating>{g.rating}</span>
      <span class="flex text-star">{[1, 2, 3, 4, 5].map(() => <Icon name="star" class="h-5 w-5" />)}</span>
    </span>
    <span class:list={['mt-1 block text-sm', dark ? 'text-white/80' : 'text-muted']}>
      <strong class={dark ? 'text-white' : 'text-navy-900'}><span data-g-count>{g.count}</span> Google reviews</strong>
      <span class="ml-1 underline-offset-2 group-hover:underline">· Read reviews</span>
    </span>
  </span>
</a>
