---
interface Props { eyebrow?: string; title: string; subtitle?: string; crumbs?: { label: string; href?: string }[] }
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;" aria-hidden="true"></div>
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-14 sm:py-20">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-white/60">
        <a href="/" class="hover:text-white">Home</a>
        {crumbs.map((c) => (<><span class="mx-2">/</span>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white/90">{c.label}</span>}</>))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow !text-brand-500">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl font-extrabold !text-white sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg text-white/75">{subtitle}</p>}
    <slot />
  </div>
</section>
