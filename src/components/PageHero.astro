---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { eyebrow?: string; title: string; subtitle?: string; crumbs?: { label: string; href?: string }[]; image?: ImageMetadata }
const { eyebrow, title, subtitle, crumbs = [], image } = Astro.props;
---
<section class="relative overflow-hidden bg-navy-900 text-white">
  {image && <Image src={image} alt="" widths={[800, 1600]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" loading="eager" />}
  <div class:list={['absolute inset-0', image ? 'bg-gradient-to-r from-navy-950/95 via-navy-900/80 to-navy-900/30' : 'bg-gradient-to-br from-navy-950 to-navy-800']} aria-hidden="true"></div>
  <div class="container-x relative pb-14 pt-32 sm:pb-20 lg:pt-44">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 text-sm text-white/70">
        <a href="/" class="hover:text-white">Home</a>
        {crumbs.map((c) => (<><span class="mx-2">/</span>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span class="text-white">{c.label}</span>}</>))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow-light">{eyebrow}</p>}
    <h1 class="mt-4 max-w-4xl text-5xl !text-white sm:text-6xl">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-lg text-white/80">{subtitle}</p>}
    <slot />
  </div>
</section>
