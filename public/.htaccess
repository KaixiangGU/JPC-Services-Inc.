# jpcservicesinc.com — Apache rules (Plesk). See DEPLOY.md for the nginx equivalent.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the bare domain (no www)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://jpcservicesinc.com%{REQUEST_URI} [L,R=301]

  # Old WordPress URLs -> new pages (keeps Google rankings and old links working)
  RewriteRule ^sungiven/?$ /projects/sungiven-foods-supermarket/ [L,R=301]
  RewriteRule ^home-copy-copy/?$ / [L,R=301]
  RewriteRule ^(shop|cart|checkout|my-account|hello-world|delivering-excellence-through-innovative-solutions)/?$ / [L,R=301]
  RewriteRule ^(category|author|tag)/ / [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [G,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
